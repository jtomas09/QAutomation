# =============================================================
#  PLANTILLA — Copiar a appium.properties y completar valores
#  appium.properties está en .gitignore (nunca se sube al repo)
#  En Railway/CI usar variables de entorno en lugar de este archivo
# =============================================================

# Modo de ejecución: local | browserstack | saucelabs
appium.mode=local

# ── LOCAL ─────────────────────────────────────────────────────
platformName=Android
deviceName=
platformVersion=
udid=

appPackage=com.cinepolis.go
appActivity=

automationName=UiAutomator2
noReset=true
fullReset=false
newCommandTimeout=180
autoGrantPermissions=true

appium.hub=http://127.0.0.1:4723/wd/hub

# ── BROWSERSTACK ──────────────────────────────────────────────
# Variable de entorno equivalente: BS_USER, BS_KEY, BS_APP_ID
browserstack.user=
browserstack.key=
browserstack.device=Samsung Galaxy A55
browserstack.os.version=14.0
browserstack.app.id=

# ── SAUCE LABS ────────────────────────────────────────────────
# Variable de entorno equivalente: SL_USER, SL_KEY, SL_APP_ID
saucelabs.user=
saucelabs.key=
saucelabs.region=us-west-1
saucelabs.device=Samsung Galaxy A54 5G
saucelabs.os.version=13
saucelabs.app.id=

# ── OTROS ─────────────────────────────────────────────────────
# Variable de entorno equivalente: MAIL_ENABLED, NETLIFY_PUBLISH, MAIL_TO, CLAUDE_API_KEY
mail.enabled=NO
netlify.publish=NO
mail.recipients=
claude.api.key=
