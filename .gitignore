# Archivos y carpetas generadas por Android Studio y Gradle
.gradle/
build/
captures/
.idea/
*.iml
local.properties

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Claves de firma (¡NUNCA SUBIR A UN REPOSITORIO!)
*.jks
*.keystore
.env
*.secret
*secrets*
smtp-config.json
**/smtp-config.json
config/smtp-config.json

# Configuración persistida en disco generada en tiempo de ejecución (backend)
backend/data/
/data/

# Configuración local con credenciales — usar variables de entorno en Railway/CI
appium.properties
**/appium.properties

# Archivos de la máquina virtual de Java/Dalvik
*.class
*.dex
hs_err_pid*

# Reportes y resultados de pruebas
allure-results/
test-reports/
build/reports/
build/test-results/
build/outputs/
screenshots/
evidence/
reports/
*.pdf
*.png
*.jpg
*.jpeg
# Excepción: assets reales del frontend (no evidencia de pruebas)
!frontend/src/assets/**/*.png

# Logs de Appium
appium.log
*.xcresult
DerivedData/

# Configuraciones locales de Appium Desktop
.appium/

# Ficheros de log genéricos
*.log

# Frontend — artefactos de build y dependencias
frontend/node_modules/
frontend/dist/

# IDE build output (Eclipse/IntelliJ)
bin/

# Maven / runner build output
runner/target/
runner/dependency-reduced-pom.xml

# Runner JAR copiado a recursos del backend (artefacto de build, no commitear)
backend/src/main/resources/installers/cinepolis-runner.jar

# Videos generados en backend (datos de ejecución local)
/videos/
backend/videos/
