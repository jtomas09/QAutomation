# =============================================================
#  PLANTILLA — Copiar a appium.properties y completar valores
#  appium.properties está en .gitignore (nunca se sube al repo)
#  En Railway/CI usar variables de entorno en lugar de este archivo
# =============================================================

# Modo de ejecución: local | browserstack | saucelabs
appium.mode=local

# Plataforma: Android | iOS
platformName=Android

# ── LOCAL ANDROID ──────────────────────────────────────────────
# (activo cuando platformName=Android)
deviceName=
platformVersion=
udid=

appPackage=com.cinepolis.go
appActivity=

automationName=UiAutomator2
noReset=true
fullReset=false
newCommandTimeout=180
autoGrantPermissions=true

appium.hub=http://127.0.0.1:4723/wd/hub

# ── LOCAL iOS ─────────────────────────────────────────────────
# (activo cuando platformName=iOS — requiere macOS + Xcode)
# deviceName=iPhone 15
# platformVersion=17.0
# udid=<UDID del dispositivo o simulador: xcrun simctl list>
# bundleId=com.cinepolis.ios
# ipaPath=          # ruta al .ipa (opcional si la app ya está instalada)
# automationName=XCUITest
# noReset=true
# newCommandTimeout=180
# appium.hub=http://127.0.0.1:4723/wd/hub
#
# Instalar driver XCUITest en Appium (solo 1 vez):
#   appium driver install xcuitest
#
# Verificar dispositivos conectados:
#   iOS real:      idevice_id -l   (requiere libimobiledevice)
#   Simuladores:   xcrun simctl list devices

# ── BROWSERSTACK — Android ────────────────────────────────────
# Variable de entorno equivalente: BS_USER, BS_KEY, BS_APP_ID
browserstack.user=
browserstack.key=
browserstack.device=Samsung Galaxy A55
browserstack.os.version=14.0
browserstack.app.id=

# ── BROWSERSTACK — iOS ────────────────────────────────────────
# browserstack.ios.device=iPhone 15
# browserstack.ios.version=17
# browserstack.app.id=     # ID del IPA subido a BrowserStack App Automate

# ── SAUCE LABS — Android ──────────────────────────────────────
# Variable de entorno equivalente: SL_USER, SL_KEY, SL_APP_ID
saucelabs.user=
saucelabs.key=
saucelabs.region=us-west-1
saucelabs.device=Samsung Galaxy A54 5G
saucelabs.os.version=13
saucelabs.app.id=

# ── SAUCE LABS — iOS ──────────────────────────────────────────
# saucelabs.ios.device=iPhone 15 Simulator
# saucelabs.ios.version=17.0
# saucelabs.app.id=   # ID del IPA subido a Sauce Labs

# ── OTROS ─────────────────────────────────────────────────────
mail.enabled=NO

# ── VIDEO ──────────────────────────────────────────────────────
# Grabar pantalla del dispositivo durante cada prueba.
# Videos guardados en build/videos/{ClassName}/{TestName}.mp4
# y adjuntados automáticamente al reporte Allure.
# Activar con: -Dvideo.enabled=true  o poner  video.enabled=true  aquí.
video.enabled=false
netlify.publish=NO
mail.recipients=
claude.api.key=
