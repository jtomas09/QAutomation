<configuration>

    <!-- FIX real (robustez Unicode): sin <charset>, el encoder usa Charset.defaultCharset()
         (el default de la JVM), no garantizado como UTF-8 en JDK 17 fuera de macOS/Linux
         (Windows en particular). Se fija explícitamente para que test-run.log (que contiene
         cada nombre de test/paso con acentos vía log.info) sea siempre UTF-8. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>build/logs/test-run.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>build/logs/test-run.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- Reduce noise from Appium/Selenium internals -->
    <logger name="io.appium" level="WARN"/>
    <logger name="org.openqa.selenium" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="org.apache.hc" level="WARN"/>

</configuration>
